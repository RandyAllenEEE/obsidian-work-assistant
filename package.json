{
  "name": "obsidian-work-assistant",
  "version": "4.5.1",
  "description": "A comprehensive productivity companion combining Calendar, Periodic Notes, and Word Count Heatmap features.",
  "author": "Randy Allen",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "lint": "svelte-check && eslint . --ext .ts",
    "verify:smtc": "node scripts/verify-smtc-hashes.mjs",
    "build": "npm run verify:smtc && npm run lint && rollup -c",
    "test": "jest --passWithNoTests",
    "test:watch": "yarn test -- --watch",
    "test:identity": "node --test scripts/plugin-id-migration.test.mjs"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "lodash": "^4.18.1",
    "obsidian-daily-notes-interface": "0.9.5",
    "qweather-icons": "^1.8.0",
    "sass": "^1.97.1",
    "svelte-writable-derived": "^3.1.1",
    "tslib": "2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/svelte": "1.0.10",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "4.20.0",
    "@typescript-eslint/parser": "4.20.0",
    "eslint": "7.23.0",
    "jest": "^30.3.0",
    "moment": "2.31.0",
    "obsidian": "1.14.4",
    "rollup": "^4.62.2",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "5.58.1",
    "svelte-check": "^4.3.5",
    "svelte-jester": "1.3.2",
    "svelte-preprocess": "^6.0.3",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.svelte$": [
        "svelte-jester",
        {
          "preprocess": true
        }
      ],
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "verbatimModuleSyntax": false
          }
        }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/src/calendar-ui/__mocks__/obsidian.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "ts",
      "svelte"
    ]
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    },
    "glob@>=9 <14.0.2": "14.0.2",
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
